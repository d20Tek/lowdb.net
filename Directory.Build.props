<Project>

	<!-- Shared build properties for all projects in the solution. -->
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Shared package metadata used by the packable library projects. -->
	<PropertyGroup>
		<Version>1.4.1</Version>
		<Company>d20Tek</Company>
		<Authors>d20Tek</Authors>
		<Copyright>Copyright (c) d20Tek.  All rights reserved.</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>package-icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/d20Tek/lowdb.net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/d20Tek/lowdb.net</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Please find the detailed release notes at https://github.com/d20Tek/lowdb.net/blob/main/CHANGELOG.md</PackageReleaseNotes>
	</PropertyGroup>

	<!-- Symbol package and Source Link settings for debugging into the libraries. -->
	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

</Project>
